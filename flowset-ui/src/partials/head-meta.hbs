{{! --- SEO & social meta (Phase 5) --- }}
{{#if page.description}}<meta name="description" content="{{page.description}}">{{/if}}
{{#if page.canonicalUrl}}<link rel="canonical" href="{{{page.canonicalUrl}}}">{{/if}}
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{site.title}}">
<meta property="og:title" content="{{#if page.title}}{{page.title}}{{else}}{{site.title}}{{/if}}">
{{#if page.description}}<meta property="og:description" content="{{page.description}}">{{/if}}
{{#if page.canonicalUrl}}<meta property="og:url" content="{{{page.canonicalUrl}}}">{{/if}}
{{#if site.url}}<meta property="og:image" content="{{site.url}}_/img/flowset-logo.png">{{/if}}
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="{{#if page.title}}{{page.title}}{{else}}{{site.title}}{{/if}}">
{{#if page.description}}<meta name="twitter:description" content="{{page.description}}">{{/if}}
{{#if site.url}}<meta name="twitter:image" content="{{site.url}}_/img/flowset-logo.png">{{/if}}

{{! --- Speed up third-party origins (Phase 5) --- }}
<link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
<link rel="preconnect" href="https://www.googletagmanager.com">
<link rel="preconnect" href="https://widget.docsbot.ai">

<link rel="shortcut icon" href="{{uiRootPath}}/img/favicon.ico" />
<link rel="icon" href="{{uiRootPath}}/img/favicon.ico" />
