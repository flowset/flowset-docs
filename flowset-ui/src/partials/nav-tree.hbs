{{#if navigation.length}}
<ul class="nav-list">
  {{#each navigation}}
  <li class="nav-item{{#if (eq ./url @root.page.url)}} is-current-page{{/if}} {{#if paid}}paid{{/if}}" data-depth="{{or ../level 0}}">
    {{#if ./content}}
    {{#if ./items.length}}
    <button class="nav-item-toggle"></button>
    {{/if}}
    {{#if ./url}}
    <a class="nav-link
      {{~! mark paid (Enterprise) pages by title so it survives version/path changes in the URL ~}}
      {{#if (or
        (eq ./content "BPM Engine Monitoring")
        (eq ./content "Jobs")
        (eq ./content "Process Instance Modification")
        (eq ./content "Batch Operations")
        (eq ./content "Sending a Message")
        (eq ./content "Process Element Documentation")
        (eq ./content "Evaluating Decisions")
        (eq ./content "Transaction Boundaries")
        (eq ./content "Heatmap")
      )}}
        paid
      {{/if}}" href="{{~#if (eq ./urlType 'internal')}}{{{relativize ./url}}}{{~else}}{{{./url}}}{{~/if}}"
  >
  {{{./content}}}
</a>
    {{else}}
    <span class="nav-text">{{{./content}}}</span>
    {{/if}}
    {{/if}}
{{> nav-tree navigation=./items level=(increment ../level)}}
  </li>
  {{/each}}
</ul>
{{/if}}

