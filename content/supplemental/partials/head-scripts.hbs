 <script>
/* Resolve the theme before first paint. fl-theme holds the choice: system (default), light or dark. */
(function () {
  var choice = 'system'
  try { choice = localStorage.getItem('fl-theme') || 'system' } catch (e) {}
  if (choice !== 'light' && choice !== 'dark') choice = 'system'
  var dark = choice === 'dark' || (choice === 'system' && window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches)
  document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light')
  document.documentElement.setAttribute('data-theme-choice', choice)
})()
</script>
 <script>uiRootPath = '{{{uiRootPath}}}'; window.FL_I18N = {{{t '@json'}}}</script>
